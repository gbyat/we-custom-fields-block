{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "we-custom-fields-block/custom-field",
  "title": "Custom Field",
  "category": "widgets",
  "icon": "admin-customizer",
  "description": "Displays a native WordPress custom field as a block",
  "keywords": ["custom field", "meta", "field"],
  "version": "0.1.0",
  "textdomain": "we-custom-fields-block",
  "attributes": {
    "fieldKey": {
      "type": "string",
      "default": ""
    },
    "displayType": {
      "type": "string",
      "default": "paragraph"
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right", "wide", "full"],
    "alignText": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontWeight": true,
      "fontStyle": true,
      "textTransform": true,
      "textDecoration": true,
      "letterSpacing": true,
      "fontFamily": true,
      "textAlign": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "layout": {
      "allowEditing": false
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
