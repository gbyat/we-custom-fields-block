{
  "name": "we-custom-fields-block",
  "version": "0.1.5",
  "description": "WordPress plugin to display native custom fields as blocks with typography and color options",
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build && node scripts/hash-json.js",
    "start": "wp-scripts start",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "wp-scripts lint-js --fix",
    "packages-update": "wp-scripts packages-update",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "sync-version": "node scripts/sync-version.js",
    "make-pot": "node scripts/create-pot.js",
    "po-to-jed": "node scripts/po-to-jed.js",
    "hash-json": "node scripts/hash-json.js"
  },
  "keywords": [
    "wordpress",
    "block",
    "custom-fields",
    "typography",
    "colors"
  ],
  "author": "Gabriele Laesser",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@wordpress/scripts": "^26.0.0",
    "copy-webpack-plugin": "^13.0.1"
  },
  "dependencies": {
    "@wordpress/block-editor": "^12.0.0",
    "@wordpress/blocks": "^12.0.0",
    "@wordpress/components": "^25.0.0",
    "@wordpress/element": "^5.0.0",
    "@wordpress/i18n": "^4.0.0"
  }
}
